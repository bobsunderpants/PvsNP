    ([true, false] : Word) ++
      (Formula.pairNotVarNotVarEncode z ++ Formula.pairVarVarEncode z))
  exact DPolyTimeComputableClean_prepend [true, false]
    (DPolyTimeComputableCleanAppend
      (fun z : Word => Formula.pairNotVarNotVarEncode z)
