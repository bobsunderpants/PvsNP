  rw [show i + zs.length + 6 = 1 + ((i + 1) + (2 + (zs.length + 2))) by omega]
  rw [Drun_add_eq, hstart]
  rw [Drun_add_eq, hscan]
  rw [Drun_add_eq, hemit]
  simpa [x, List.append_assoc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hskip

