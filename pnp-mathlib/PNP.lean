  · simp [DDescDispatchTM, DDescDispatchState.tag, DDescDispatchState.copyF]
  · simp [DDescDispatchTM, DDescDispatchState.tag, DDescDispatchState.copyF]
  · simp [DDescDispatchTM, DDescDispatchState.tag, DDescDispatchState.copyF, DDescDispatchState.done]
