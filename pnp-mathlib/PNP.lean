lemma Drun_DNotNodePairTM_scan1_trues (pre zs out : Word) (i : Nat)
    (wk : Nat → Bool) (wh : Nat) :
    Drun DNotNodePairTM (i + 1)
      { state := DNotNodePairState.scan1,
        input := pre ++ List.replicate i true ++ false :: zs,
