    ∃ s : Nat, s ≤ z.length + z.length + 6 ∧
      Dhalted DTrunc3VarTagTM (Drun DTrunc3VarTagTM s (Dinit DTrunc3VarTagTM z)) = true ∧
      (Drun DTrunc3VarTagTM s (Dinit DTrunc3VarTagTM z)).output =
