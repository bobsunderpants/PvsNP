  have hemit := Drun_DInsertVarTagTM_emit (List.replicate k true)
    (List.replicate k true) (k + 1) (fun _ : Nat => false) 0
  have hcopy : Drun DInsertVarTagTM 1
      { state := DInsertVarTagState.copyRest, input := List.replicate k true,
